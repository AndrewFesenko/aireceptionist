<h2>Edit Tenant</h2>
<form method="post">
    <label>Name <input name="name" value="<%= t.name %>" /></label><br/>
    <label>Phone <input name="phone_number" value="<%= t.phone_number %>" /></label><br/>
    <label>Forward Number <input name="forward_number" value="<%= t.forward_number %>" /></label><br/>
    <label>Prompt<br/>
        <textarea name="prompt" rows="6" cols="50"><%= t.prompt %></textarea>
    </label><br/>
    <button type="submit">Save</button>
</form>

<form method="post" action="/admin/tenants/<%= t.id %>/delete" onsubmit="return confirm('Are you sure you want to delete this tenant?');">
    <button type="submit" style="margin-top:10px; color:red;">Delete Tenant</button>
</form>
